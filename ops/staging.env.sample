# Template for the ignored ops/staging.env on an isolated staging host.
# See docs/runbooks/STAGING_VALIDATION.md#staging-credentials-and-network-access.
# Do not store live integration credentials, chat IDs or invite links in Git.

COMPOSE_PROJECT_NAME=clinic-staging

POSTGRES_USER=clinic_staging
POSTGRES_PASSWORD=
POSTGRES_DB=clinic_staging

SECRET_KEY=
# Optional legacy alias. Leave empty to use SECRET_KEY.
AUTH_SECRET=

# Required. Choose an explicit first-run admin username.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Staging Administrator

APP_NAME=Clinic Manager Staging
APP_VERSION=1.1.0-staging
TIMEZONE=Asia/Tashkent
WORKERS=2
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional Sentry destinations for isolated staging. Leave empty to disable.
# Use staging-specific projects when checking delivery; frontend DSN is public
# and embedded in the built JavaScript bundle. GitHub environment variable
# mapping: STAGING_SENTRY_DSN -> SENTRY_DSN;
# STAGING_VITE_SENTRY_DSN -> VITE_SENTRY_DSN.
SENTRY_DSN=
VITE_SENTRY_DSN=

# Optional. Use a dedicated staging bot only; never put a production token here.
# A bot token saved in the staging database takes precedence over this env value.
TELEGRAM_BOT_TOKEN=

# Verifier-only inputs below are documented here, not passed to app containers
# or loaded by the Compose app. Supply them only to the authorized verifier.
# STAGING_SENTRY_EVENT_READ_TOKEN=        # Proposed; not provisioned. Never use a release token.
# STAGING_TELEGRAM_CHAT_ID=               # Private group only, for manual transport smoke.
# STAGING_TELEGRAM_CHALLENGE=             # GitHub environment secret for one-shot private reminder.
# One-shot reminder discovers the positive private recipient ID at run time.

STAGING_PUBLIC_HOST=127.0.0.1
STAGING_FRONTEND_PORT=18080
# Keep the staging backend separate from Windows production on port 18000.
STAGING_BACKEND_PORT=18001
STAGING_POSTGRES_HOST_PORT=15432

STAGING_PUBLIC_BASE_URL=http://127.0.0.1:18080
STAGING_PUBLIC_WS_URL=ws://127.0.0.1:18080
STAGING_PUBLIC_WS_HOST=127.0.0.1:18080
CORS_ORIGINS=http://127.0.0.1:18080,http://localhost:18080

EMR_LEGACY_WRITE_FREEZE=1
