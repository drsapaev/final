ENV=staging
APP_NAME=Clinic Manager
APP_VERSION=1.1.0
API_V1_STR=/api/v1

# Required. Use the password created by bootstrap_postgres.sh.
DATABASE_URL=

# Required. Generate with Python secrets.token_urlsafe(48).
SECRET_KEY=
# Optional legacy alias. Leave empty to use SECRET_KEY.
AUTH_SECRET=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

CORS_ALLOW_ALL=0
CORS_DISABLE=0
BACKEND_CORS_ORIGINS=https://staging.example.com,https://clinic.example.com

TIMEZONE=Asia/Tashkent
QUEUE_START_HOUR=7
ONLINE_MAX_PER_DAY=15

REQUIRE_LICENSE=0
LICENSE_ALLOW_HEALTH=1
AUTO_BACKUP_ENABLED=1
BACKUP_HOUR=2
BACKUP_MINUTE=0
EMR_LEGACY_WRITE_FREEZE=1
ENABLE_DEV_AUTH=false
WS_DEV_ALLOW=0

BACKEND_HOST=127.0.0.1
BACKEND_PORT=18000
BACKEND_RELOAD=0

# Trusted proxy whitelist (PR-34): the direct TCP peer whose
# X-Forwarded-For header may be honored. Nginx proxies from loopback to
# uvicorn on 127.0.0.1:18000 and OVERWRITES the chain with $remote_addr
# (see ops/vps/nginx/clinic.conf.template), so loopback is the only peer
# allowed to set it. Without this, audit rows and rate limiting would
# record 127.0.0.1 instead of the real client IP.
TRUSTED_PROXIES=127.0.0.1

LOG_LEVEL=INFO
LOG_STRUCTURED=1
