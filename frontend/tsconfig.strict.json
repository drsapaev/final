{
  // Wave G7-G8: per-directory strict mode.
  //
  // This tsconfig enables `strict: true` for directories that are ready
  // (0 errors under strict). The main tsconfig.json stays non-strict
  // until ALL directories are ready, then G8 flips the main config.
  //
  // Usage:
  //   npx tsc --noEmit -p tsconfig.strict.json
  //
  // CI gate: scripts/strict-gate.mjs runs this and fails on any error.
  // When a new directory becomes ready, add it to `include` and commit.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true
  },
  "include": [
    "src/types/declarations.d.ts",
    "src/api/mappers/**/*.ts",
    "src/api/mappers/**/*.tsx",
    "src/types/domain/**/*.ts",
    "src/types/domain/**/*.tsx",
    "src/types/**/*.ts",
    "src/api/**/*.ts",
    "src/stores/**/*.ts",
    "src/stores/**/*.tsx",
    "src/i18n/useTranslation.ts",
    "src/routing/**/*.ts",
    "src/routing/**/*.tsx",
    "src/components/medical/**/*.ts",
    "src/components/medical/**/*.tsx",
    "src/components/Icon.tsx",
    "src/components/ui/macos/**/*.ts",
    "src/components/ui/macos/**/*.tsx",
    "src/components/ui/**/*.ts",
    "src/components/ui/**/*.tsx",
    "src/components/registrar/**/*.ts",
    "src/components/registrar/**/*.tsx",
    "src/components/common/Loading.tsx",
    "src/components/common/RoleGuard.tsx",
    "src/components/common/ConfirmDialog.tsx",
    "src/components/auth/RequireAuth.tsx",
    "src/components/auth/ForgotPassword.tsx",
    "src/components/auth/LoginFormStyled.tsx",
    "src/components/auth/PhoneVerification.tsx",
    "src/components/auth/loginErrorUtils.ts",
    "src/components/AnimatedLoader.tsx",
    "src/components/TwoFactorVerify.tsx",
    "src/components/dialogs/ModernDialog.tsx",
    "src/components/dialogs/CancelDialog.tsx",
    "src/components/dialogs/PaymentDialog.tsx",
    "src/components/queue/**/*.ts",
    "src/components/queue/**/*.tsx",
    "src/contexts/**/*.ts",
    "src/contexts/**/*.tsx",
    "src/services/sentry.ts",
    "src/services/queue.ts",
    "src/services/notify.ts",
    "src/services/pushNotifications.ts",
    "src/constants/routes.ts",
    "src/constants/messagingContract.ts",
    "src/utils/heicConverter.ts",
    "src/utils/sanitizer.ts",
    "src/utils/navigation.ts",
    "src/utils/errorHandler.ts",
    "src/hooks/useSetupStatus.ts",
    "src/hooks/useSessionTimeoutWarning.ts",
    "src/hooks/uiAnimations.ts",
    "src/hooks/useEMRTemplateLibrary.ts",
    "src/hooks/useUsers.ts",
    "src/hooks/usePWA.ts",
    "src/hooks/useAppointments.ts",
    "src/hooks/useDoctorPhrases.ts",
    "src/hooks/useFinance.ts",
    "src/hooks/useUserPreferences.ts",
    "src/hooks/usePatients.ts",
    "src/hooks/useEMR.ts",
    "src/hooks/useReports.ts",
    "src/hooks/useAIChat.ts",
    "src/utils/registrarAggregation.ts",
    "src/components/ui/macos/MacOSPagination.tsx",
    "src/components/mobile/QueuePositionCard.tsx",
    "src/components/patient/patientUtils.ts",
    "src/components/common/StateWrapper.tsx",
    "src/services/queue.ts",
    "src/pages/PaymentCancel.tsx"
  ],
  "exclude": ["node_modules", "dist", "e2e"]
}
