# syntax=docker/dockerfile:1.7

FROM node:20.19.6-slim AS builder

ARG VITE_API_BASE=/api/v1
ARG VITE_API_URL=http://localhost:18080
ARG VITE_API_BASE_URL=http://localhost:18080
ARG VITE_WS_URL=ws://localhost:18080
ARG VITE_WS_HOST=localhost:18080
ARG VITE_SENTRY_DSN=
ARG VITE_SENTRY_ENV=staging
ARG VERCEL_GIT_COMMIT_SHA=

ENV CI=true \
    NODE_ENV=production \
    VITE_API_BASE=${VITE_API_BASE} \
    VITE_API_URL=${VITE_API_URL} \
    VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_WS_URL=${VITE_WS_URL} \
    VITE_WS_HOST=${VITE_WS_HOST} \
    VITE_SENTRY_DSN=${VITE_SENTRY_DSN} \
    VITE_SENTRY_ENV=${VITE_SENTRY_ENV} \
    VERCEL_GIT_COMMIT_SHA=${VERCEL_GIT_COMMIT_SHA}

WORKDIR /app

COPY package.json /app/package.json
COPY package-lock.json /app/package-lock.json
RUN npm ci --legacy-peer-deps --include=dev

COPY src /app/src
COPY public /app/public
COPY index.html /app/index.html
COPY vite.config.ts /app/vite.config.ts
COPY sw.template.js /app/sw.template.js

RUN npm run build

FROM nginx:1.27-alpine AS artifact-runtime

ARG VERCEL_GIT_COMMIT_SHA=

COPY docker/nginx.staging.conf /etc/nginx/conf.d/default.conf
COPY --from=staging_artifact . /usr/share/nginx/html/

# The hosted artifact is built from an exact Git revision and carries a
# checksum manifest. Reject a missing/mismatched source or modified files
# before the static bundle can be used by a staging container.
RUN set -eu; \
    cd /usr/share/nginx/html; \
    test -n "$VERCEL_GIT_COMMIT_SHA"; \
    test "$(cat source.sha)" = "$VERCEL_GIT_COMMIT_SHA"; \
    sha256sum -c SHA256SUMS; \
    test -z "$(find . -type l -print -quit)"; \
    manifest_files="$(awk 'NF == 2 { print $2 } NF != 2 { exit 1 }' SHA256SUMS | LC_ALL=C sort)"; \
    copied_files="$(find . -type f ! -path './SHA256SUMS' -print | LC_ALL=C sort)"; \
    test "$manifest_files" = "$copied_files"; \
    rm -f source.sha SHA256SUMS

EXPOSE 80

FROM nginx:1.27-alpine AS runtime

COPY docker/nginx.staging.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
