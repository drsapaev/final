+      let committed = false;
+      apiGet.mockImplementation(async (url: string) => {
+        if (url === '/doctor/my-info') return MY_INFO;
+        if (url !== '/doctor/general/queue/today') throw new Error(`Unexpected read: ${url}`);
+        if (!committed) return QUEUE;
+        return {
+          data: {
+            ...QUEUE.data,
+            entries: [{
+              ...QUEUE.data.entries[0], status: 'called', available_actions: ['start_visit'],
+              can_call: false, can_start_visit: true,
+            }],
+          },
+        };
+      });
+      apiPost.mockImplementation(async () => {
+        committed = committedCall;
+        return { data: ack ? { ...ack, message: 'Синтетический вызов' } : null };
+      });
+      render(<DoctorQueuePanel specialty="general" />);
+      await userEvent.setup().click(await screen.findByRole('button', { name: /Вызвать/ }));
+      expect(await screen.findByRole('button', { name: committedCall ? /Начать/ : /Вызвать/ })).toBeInTheDocument();
+      expect(apiPost).toHaveBeenCalledExactlyOnceWith('/doctor/queue/11/call');
+      const text = 'Пациент вызван. Объявление на табло подтверждено не полностью.';
+      const shown = warning.mock.calls.some(([message]) => message === text)
+        || screen.queryByText(text) !== null;
+      expect(shown).toBe(expectWarning);
+    } finally {
+      warning.mockRestore();
+    }
+  });
+});
