+describe('manual General Doctor display delivery acceptance', () => {
+  it.each([
+    ['partial', { success: true, display_delivery: 'partial' }, true, true],
+    ['unconfirmed', { success: true, display_delivery: 'unconfirmed' }, true, true],
+    ['delivered', { success: true, display_delivery: 'delivered_local' }, true, false],
