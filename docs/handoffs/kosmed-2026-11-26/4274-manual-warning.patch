+    ['rejected', { success: false, display_delivery: 'partial' }, false, false],
+    ['unreadable', null, false, false],
+  ] as const)('handles %s without repeating the call', async (_, ack, committedCall, expectWarning) => {
+    const warning = vi.spyOn((await import('../../../services/notify')).default, 'warning');
