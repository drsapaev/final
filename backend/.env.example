ENV=dev
APP_NAME="Clinic Queue Manager"
APP_VERSION="0.9.0"
API_V1_STR=/api/v1
TIMEZONE=Asia/Tashkent

# CORS: when allow-all mode is enabled, the origin list is ignored.
CORS_DISABLE=0
CORS_ALLOW_ALL=0
# через запятую; должен совпадать с адресами фронта
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:4174,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:4173,http://127.0.0.1:4174,http://127.0.0.1:8080

# Database
DATABASE_URL=

# --- DB connection resilience (P0 follow-up, PR: db-connect-resilience) --
# Bounded libpq waits for the remote PostgreSQL/Supabase pooler. Defaults
# below are production-safe; set 0 to disable a knob.
#   DB_CONNECT_TIMEOUT_S      TCP+TLS+auth budget per new connection (s)
#   DB_TCP_KEEPALIVE_*        dead-route detection mid-query (no-op on
#                             Windows clients, effective on Linux hosts)
#   DB_STATEMENT_TIMEOUT_MS   server-side per-statement cancel; Alembic and
#                             pg_dump bypass the app engine and are exempt
#   DB_APPLICATION_NAME       shows up in pg_stat_activity on Supabase
DB_CONNECT_TIMEOUT_S=10
DB_TCP_KEEPALIVE_IDLE_S=30
DB_TCP_KEEPALIVE_INTERVAL_S=10
DB_TCP_KEEPALIVE_COUNT=5
DB_STATEMENT_TIMEOUT_MS=60000
DB_APPLICATION_NAME=clinic-api

# --- Trusted proxies (audit trail + rate-limit attribution) -------------
# Comma-separated IPs/CIDRs of the DIRECT TCP peer that is allowed to set
# X-Forwarded-For. Only the direct peer counts: any other caller keeps its
# own peer IP, so arbitrary clients cannot forge the recorded source.
# List EVERY reverse-proxy hop between the client and the backend (the
# resolver walks the forwarded chain right-to-left skipping the hops you
# list to recover the real client IP).
# Canonical Cloudflare Tunnel deployment (docs/runbooks/DEPLOYMENT_NEW_CLINIC.md):
# cloudflared dials uvicorn on localhost:18000 from the same Windows host,
# so the direct peer is loopback (::1 covers hosts where cloudflared
# resolves localhost to IPv6). Without this, every audit row and rate-limit
# key records 127.0.0.1 instead of the real client IP.
# VPS deployment: keep 127.0.0.1 (nginx proxies from loopback) — see
# ops/vps/backend.env.sample.
TRUSTED_PROXIES=127.0.0.1,::1

# Auth / JWT
# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
# PR-33 / High-43: access tokens must be short-lived (15-60 min, industry standard).
# Refresh tokens (30-day expiry) handle long sessions. A stolen access token
# with 7-day expiry (was 10080) gives an attacker a week of access.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Legacy/fallback auth endpoints. Keep disabled outside explicit break-glass or dev use.
ENABLE_FALLBACK_AUTH=0

# Legacy simple upload endpoint. Keep disabled unless the hardened simple endpoint is intentionally used.
ENABLE_SIMPLE_FILE_UPLOAD=0

# Tenant scope guard for branch-owned write endpoints
TENANT_SCOPE_ENFORCE_WRITES=0
TENANT_SCOPE_WRITE_PREFIXES=/api/v1/billing,/api/v1/queue,/api/v1/emr,/api/v1/v2/emr,/api/v1/clinic/equipment

# Printing / PDFs
CLINIC_LOGO_PATH=
PDF_FOOTER_ENABLED=1

# ESC/POS printer
PRINTER_TYPE=none        # none|network|usb
PRINTER_NET_HOST=
PRINTER_NET_PORT=9100
PRINTER_USB_VID=
PRINTER_USB_PID=

# Payment providers are disabled until all required credentials are set.
CLICK_ENABLED=0
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_BASE_URL=https://api.click.uz/v2

PAYME_ENABLED=0
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_BASE_URL=https://checkout.paycom.uz
PAYME_API_URL=https://api.paycom.uz

KASPI_ENABLED=0
KASPI_MERCHANT_ID=
KASPI_SECRET_KEY=
KASPI_BASE_URL=https://kaspi.kz/pay
KASPI_API_URL=https://api.kaspi.kz/pay/v1

# Licensing
REQUIRE_LICENSE=0
LICENSE_ALLOW_HEALTH=1

# Docker Compose / staging alternative:
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=clinic
# DB_PASSWORD=
# DB_NAME=clinicdb
# DATABASE_URL=postgresql+psycopg://clinic:<db_password>@postgres:5432/clinicdb

# ===== Redis (на будущее) =====
# REDIS_URL=redis://redis:6379/0

# --- Sentry (backend error monitoring) ---
# sentry-sdk is in backend/requirements-monitoring.txt.
# PR-30: SENTRY_DSN must NOT be checked in with an active value — otherwise
# every dev clone auto-reports errors to a shared Sentry project. Uncomment
# and set your own project's DSN in your local .env (or CI/CD secret store).
# SENTRY_DSN="https://<your-org-key>@<your-sentry-host>/<project-id>"
SENTRY_DSN=""
SENTRY_ENV="development"                # set to 'staging' / 'production' in deployment
SENTRY_TRACES_SAMPLE_RATE=0.05          # 5% perf traces — errors always captured
APP_VERSION="0.9.0"                     # used as Sentry release tag

# Install backend monitoring deps:
#   pip install -r backend/requirements-monitoring.txt
#
# See docs/runbooks/SENTRY_SETUP.md for full setup instructions.

# --- Prometheus metrics (optional) ---
# Set to 0 to disable /metrics endpoint. Default: 1 (enabled if prometheus-client installed).
# prometheus-client is in backend/requirements-monitoring.txt.
# ENABLE_PROMETHEUS=1

# DOCKER-DEPLOY-AUDIT: required for production
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# SMS provider (at least one required in production)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
PLAYMOBILE_API_KEY=
PLAYMOBILE_API_SECRET=

# Email / SMTP (2FA recovery letters)
# Brevo example: SMTP_SERVER=smtp-relay.brevo.com, SMTP_PORT=587,
# SMTP_USERNAME=<brevo login>, SMTP_PASSWORD=<brevo SMTP key>.
# SMTP_FROM must be an address on a domain verified at the provider.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@finalclinic.fyi

# --- Offsite backups: Cloudflare R2 (#2772) -------------------------------
# Values from R2 -> Manage API Tokens -> "finalclinic-backup-writer"
# (Object Read & Write, scoped ONLY to bucket finalclinic-db-backups).
# Account ID also equals the subdomain of the S3 endpoint.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional override; default finalclinic-db-backups
R2_BUCKET=
