{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevBrain memory benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "status",
    "model",
    "cli_version",
    "source_fingerprint",
    "baseline_commit",
    "created_at_utc",
    "runs",
    "summary",
    "blockers",
    "safety_failures"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "experiment_id": { "type": "string", "format": "uuid" },
    "status": {
      "enum": [
        "PILOT_RUNNING",
        "PILOT_COMPLETED",
        "PILOT_BLOCKED",
        "PILOT_QUALITY_FAILED",
        "PILOT_USAGE_UNAVAILABLE",
        "EXPANDED_RUNNING",
        "EXPANDED_COMPLETED",
        "EXPANDED_BLOCKED",
        "EXPANDED_QUALITY_FAILED",
        "EXPANDED_USAGE_UNAVAILABLE"
      ]
    },
    "model": { "const": "gpt-6-luna" },
    "cli_version": { "type": ["string", "null"] },
    "source_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baseline_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "runs": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "variant",
          "phase",
          "task_id",
          "source_fingerprint",
          "session_id",
          "status",
          "reason_code",
          "elapsed_ms",
          "output_bytes",
          "helper_calls",
          "usage_status",
          "input_tokens",
          "cached_input_tokens",
          "output_tokens",
          "assertions"
        ],
        "properties": {
          "scenario_id": { "type": "string" },
          "variant": { "enum": ["legacy_manual", "automatic_helper"] },
          "phase": { "enum": ["capture", "recall"] },
          "task_id": { "type": ["string", "null"] },
          "source_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "session_id": { "type": ["string", "null"] },
          "status": { "enum": ["completed", "failed", "blocked"] },
          "reason_code": { "type": ["string", "null"] },
          "elapsed_ms": { "type": "integer", "minimum": 0 },
          "output_bytes": { "type": "integer", "minimum": 0 },
          "helper_calls": { "type": "integer", "minimum": 0 },
          "usage_status": { "enum": ["AVAILABLE", "USAGE_UNAVAILABLE"] },
          "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "assertions": {
            "type": "object",
            "additionalProperties": { "type": "boolean" }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usage_status",
        "legacy_input_tokens",
        "automatic_input_tokens",
        "legacy_cached_input_tokens",
        "automatic_cached_input_tokens",
        "legacy_output_tokens",
        "automatic_output_tokens",
        "legacy_elapsed_ms",
        "automatic_elapsed_ms",
        "median_input_reduction_percent",
        "median_elapsed_change_percent",
        "quality_pass"
      ],
      "properties": {
        "usage_status": { "enum": ["AVAILABLE", "USAGE_UNAVAILABLE"] },
        "legacy_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "automatic_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "legacy_cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "automatic_cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "legacy_output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "automatic_output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "legacy_elapsed_ms": { "type": ["integer", "null"], "minimum": 0 },
        "automatic_elapsed_ms": { "type": ["integer", "null"], "minimum": 0 },
        "median_input_reduction_percent": { "type": ["number", "null"] },
        "median_elapsed_change_percent": { "type": ["number", "null"] },
        "quality_pass": { "type": ["boolean", "null"] }
      }
    },
    "blockers": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 300 } },
    "safety_failures": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 300 } }
  }
}
